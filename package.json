{
  "name": "ahv-remote-console",
  "version": "1.0.0",
  "private": true,
  "description": "AHV Remote Console — secure enterprise remote console for Nutanix AHV.",
  "license": "Apache-2.0",
  "author": {
    "name": "The AHV Remote Console Authors",
    "url": "https://github.com/MarcoCarvin/ahv-remote-console"
  },
  "homepage": "https://github.com/MarcoCarvin/ahv-remote-console",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcoCarvin/ahv-remote-console.git"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @ahv-remote-console/desktop build",
    "build:runtime": "make -C apps/runtime build",
    "build:plugins": "make -C plugins/ahv build",
    "build:all": "pnpm build:runtime && pnpm build:plugins && pnpm build",
    "dev": "pnpm -r --parallel --filter './packages/**' --filter @ahv-remote-console/desktop dev",
    "dev:runtime": "make -C apps/runtime dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:go": "make -C apps/runtime lint && make -C plugins/ahv lint",
    "test": "pnpm -r test",
    "test:go": "make -C apps/runtime test && make -C plugins/ahv test",
    "test:all": "pnpm test:go && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "package": "pnpm build:all && pnpm --filter @ahv-remote-console/desktop package",
    "package:win": "pnpm build:all && pnpm --filter @ahv-remote-console/desktop package:win",
    "package:linux": "pnpm build:all && pnpm --filter @ahv-remote-console/desktop package:linux",
    "package:mac": "pnpm build:all && pnpm --filter @ahv-remote-console/desktop package:mac",
    "build:icons": "node scripts/build-icons.mjs && node scripts/build-icon-sprite.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "notices:generate": "node scripts/gen-third-party-notices.mjs",
    "clean": "pnpm -r clean && make -C apps/runtime clean && make -C plugins/ahv clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "husky": "9.1.7",
    "png2icons": "^2.0.1",
    "prettier": "3.8.3",
    "sharp": "^0.34.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  }
}
