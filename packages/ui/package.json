{
  "name": "@ahv-remote-console/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./reset.css": "./src/reset.css"
  },
  "files": [
    "dist",
    "src/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rimraf dist .tsbuildinfo",
    "lint": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.3.0",
    "framer-motion": "12.39.0",
    "react": "19.2.6",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
