{
  "name": "@ahv-remote-console/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rimraf dist .tsbuildinfo",
    "lint": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ahv-remote-console/protocol": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
