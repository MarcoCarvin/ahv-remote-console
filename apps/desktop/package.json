{
  "name": "@ahv-remote-console/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AHV Remote Console desktop shell (Electron + React).",
  "author": "The AHV Remote Console Authors",
  "homepage": "https://github.com/MarcoCarvin/ahv-remote-console",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "NODE_ENV=production vite build --config vite.renderer.config.ts && NODE_ENV=production vite build --config vite.main.config.ts && NODE_ENV=production vite build --config vite.preload.config.ts",
    "dev": "node scripts/dev.mjs",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:linux": "pnpm build && electron-builder --linux",
    "package:mac": "pnpm build && electron-builder --mac",
    "clean": "rimraf dist release .vite",
    "lint": "eslint . --max-warnings 520",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "package:mac:dev": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 -c.mac.entitlements=../../build/entitlements.mac.dev.plist -c.mac.entitlementsInherit=../../build/entitlements.mac.dev.plist -c.mac.artifactName='${productName}-${version}-DEV-UNSIGNED-${arch}.${ext}'"
  },
  "dependencies": {
    "@ahv-remote-console/native-keyhook": "workspace:*",
    "@ahv-remote-console/protocol": "workspace:*",
    "@ahv-remote-console/sdk": "workspace:*",
    "@ahv-remote-console/telemetry": "workspace:*",
    "@ahv-remote-console/ui": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/jost": "^5.2.8",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "framer-motion": "12.39.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "3.1.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "rimraf": "6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
